{
  "name": "cluadflare-worker-waitlist",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "client": "astro dev",
    "build:client": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint 'src/**/*.{js,ts,tsx,astro}'",
    "worker": "wrangler dev",
    "dev": "concurrently \"bun run client\" \"bun run worker\"",
    "dry-run:staging": "bun run build:client && wrangler deploy --dry-run --env staging",
    "dry-run:prod": "bun run build:client && wrangler deploy --dry-run --env production",
    "deploy:staging": "bun run build:client && wrangler deploy --env staging",
    "deploy:prod": "bun run build:client && wrangler deploy --env production",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cf_worker_waitlist_local_db --local ",
    "db:migrate:staging": "wrangler d1 migrations apply cf_worker_waitlist_db --remote --env staging",
    "create:test:db": "bun run ./scripts/test-db.ts",
    "destroy:test:db": "bun run ./scripts/destroy-test-db.ts",
    "test": "bun run create:test:db && bun test && bun run destroy:test:db"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.5",
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/figtree": "^5.2.10",
    "@hugeicons/core-free-icons": "^4.1.4",
    "@hugeicons/react": "^1.1.6",
    "@tailwindcss/vite": "^4.3.0",
    "@typescript-eslint/parser": "^8.59.4",
    "astro": "^6.3.5",
    "bun-types": "^1.3.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.21",
    "jose": "^6.2.3",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260523.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "eslint-plugin-astro": "^1.7.0",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
