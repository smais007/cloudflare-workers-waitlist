{
  "name": "cluadflare-worker-waitlist",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-05-21",
  "assets": {
    "directory": "./dist",
    "bindings": "ASSETS"
  },
  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging"
      }
    },
    "production": {
      "vars": {
        "ENVIRONMENT": "production"
      }
    }
  }
}
